{
  "expo": {
    "name": "ShopStops",
    "slug": "shopstops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shopstops.client",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ShopStops shares your location with your assigned delivery route while you are on duty.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ShopStops shares your location with your assigned delivery route while background location sharing is turned on."
      }
    },
    "android": {
      "package": "com.shopstops.client",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#19352f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "imageWidth": 180,
        "resizeMode": "contain",
        "backgroundColor": "#19352f"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ShopStops shares your location with your assigned delivery route while background location sharing is turned on.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "scheme": "shopstops"
  }
}
