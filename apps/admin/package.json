{
  "name": "admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:acceptance": "playwright test",
    "test:release": "npm test && npm run lint && npm run build && npm run test:acceptance",
    "check:release": "node --experimental-strip-types ../../scripts/check-frontend-release.mjs admin",
    "build:release": "npm run check:release && npm run build",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:finance": "node --experimental-strip-types --test tests/finance.test.mjs",
    "test:shopper": "node --experimental-strip-types --test tests/shopper.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
